# Public Supabase config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_BUCKET=images

# Canonical site URL for SEO metadata (production domain)
# NEXT_PUBLIC_SITE_URL=https://photos.your-domain.com

# Engineering portfolio (separate Vercel project)
# NEXT_PUBLIC_RECRUITER_URL=https://your-domain.com

# FastAPI for admin upload/delete (no trailing slash).
# Local: separate uvicorn process on :8000. Production (photography Vercel project):
# optional — defaults to same-origin https://your-photo-domain/api when unset in the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Gallery reads use the public Supabase vars above (anon/publishable key + RLS).
