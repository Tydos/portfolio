# Public Supabase config (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_BUCKET=images

# Canonical site URL for SEO metadata (production domain)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# FastAPI base for admin upload/delete (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only read credentials (used by /api/images — never prefix with NEXT_PUBLIC_)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_KEY=service-role-key-only-if-needed-server-side
