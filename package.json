{
  "name": "portfolio-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:portfolio": "npm run dev -w @portfolio/portfolio",
    "dev:gallery": "npm run dev -w @portfolio/gallery",
    "dev:api": "npm run dev -w @portfolio/image-api",
    "dev:api:bench": "npm run dev:bench -w @portfolio/image-api",
    "dev:image": "concurrently \"npm run dev:api\" \"npm run dev:gallery\"",
    "build:portfolio": "npm run build -w @portfolio/portfolio",
    "build:gallery": "npm run build -w @portfolio/gallery",
    "build:api": "npm run build -w @portfolio/image-api",
    "test:api": "npm test -w @portfolio/image-api",
    "seed": "npm run seed -w @portfolio/image-api",
    "benchmark": "npm run benchmark -w @portfolio/image-api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.33.5": true
  }
}
